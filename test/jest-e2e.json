{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "<rootDir>/jest-esm-transformer.cjs"
  },
  "transformIgnorePatterns": [
    "node_modules[\\\\/](?!@nestjs[\\\\/](config|mongoose|terminus)[\\\\/])"
  ]
}
